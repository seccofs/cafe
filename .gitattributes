# Force symlink handling across all platforms
* text=auto
*.md text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf

# Treat as symlink (git will understand this as a symlink across all platforms)
CLAUDE.md symlink

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.cafe binary
